#!/usr/bin/env bash
# Durable entry point installed by Home Manager. The implementation stays in the
# validated configuration checkout so updates take effect as soon as it syncs.
# The checkout location is recorded state, not something to configure by typing.
set -euo pipefail
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/bro/checkout"
[ -r "$state_file" ] || {
  printf 'bro: ERROR: no installed checkout; rerun the installer\n' >&2
  exit 1
}
repo=$(cat "$state_file")
[ -x "$repo/scripts/bro" ] || {
  printf 'bro: ERROR: recorded checkout is unusable: %s\n' "$repo" >&2
  exit 1
}
exec "$repo/scripts/bro" "$@"
