#!/usr/bin/env bash
# Resumable, post-activation account setup. Never run from Home Manager
# activation itself: every login remains an explicit user action.
set -euo pipefail

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/proton-pass
pass_env=$config_dir/pi.env
git_identity_file=${XDG_CONFIG_HOME:-$HOME/.config}/git/identity
pi_auth=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/auth.json
readonly PROVIDER_LABELS=(DeepSeek Gemini Moonshot)
readonly PROVIDER_ENV_NAMES=(DEEPSEEK_API_KEY GEMINI_API_KEY MOONSHOT_API_KEY)
readonly PROVIDER_ITEM_TITLES=(llm-deepseek llm-google llm-moonshotai)
readonly PROVIDER_ITEM_ALIASES=('' llm-gemini llm-moonshot)

STATUS_PROTON='not configured'
STATUS_PI_KEYS='not configured'
STATUS_PI_LOGIN='not configured'
STATUS_GIT_IDENTITY='not configured'
STATUS_GITHUB='not configured'
STATUS_CLOUDFLARED='not configured'
STATUS_WRANGLER='not configured'
PROVIDER_STATUS=('not configured' 'not configured' 'not configured')
CONFIGURED_REFERENCES=('' '' '')
CHOICE=''

log() {
  printf '  %s\n' "$1"
}

warn() {
  printf '  ! %s\n' "$1" >&2
}

fail() {
  printf 'nix-config-setup: ERROR: %s\n' "$1" >&2
  exit 1
}

section() {
  printf '\n== %s ==\n' "$1"
}

usage() {
  cat <<'EOF'
Usage: nix-config-setup [--check]

Without options, opens an editor-free setup wizard for optional Proton Pass
API keys, Pi account login, Git identity, GitHub CLI, Cloudflare Tunnel, and
Wrangler. It is safe to rerun: ready accounts and references are preserved.

--check  report current setup status without prompting or changing files
EOF
}

has_tty() {
  [ -r /dev/tty ] && [ -w /dev/tty ]
}

ask_optional() {
  local prompt=$1
  local default_answer=${2:-yes}
  local answer
  while true; do
    case "$default_answer" in
      yes) printf '%s [Y/n/s] ' "$prompt" >/dev/tty ;;
      no) printf '%s [y/N/s] ' "$prompt" >/dev/tty ;;
      *) printf '%s [y/n/S] ' "$prompt" >/dev/tty ;;
    esac
    IFS= read -r answer </dev/tty || true
    [ -n "$answer" ] || answer=$default_answer
    case "$answer" in
      y|Y|yes|YES) CHOICE=yes; return 0 ;;
      n|N|no|NO) CHOICE=no; return 0 ;;
      s|S|skip|SKIP) CHOICE=skip; return 0 ;;
      *) warn 'Please answer y, n, or s (skip for now).' ;;
    esac
  done
}

ask_retry() {
  local prompt=$1
  local answer
  while true; do
    printf '%s [r]etry/[s]kip: ' "$prompt" >/dev/tty
    IFS= read -r answer </dev/tty || true
    case "$answer" in
      ''|r|R|retry|RETRY) CHOICE=retry; return 0 ;;
      s|S|skip|SKIP) CHOICE=skip; return 0 ;;
      *) warn 'Please answer r to retry or s to skip for now.' ;;
    esac
  done
}

pass_logged_in() {
  command -v pass-cli >/dev/null 2>&1 && pass-cli info >/dev/null 2>&1
}

login_proton_pass() {
  local method pat
  pass_logged_in && { STATUS_PROTON=ready; log 'Proton Pass session is ready.'; return 0; }

  if [ "$(uname -s)" = Linux ] \
    && { ! command -v keyctl >/dev/null 2>&1 || ! keyctl show >/dev/null 2>&1; }; then
    warn 'The Linux kernel keyring is unavailable in this shell.'
    warn 'Exit and run bro auth to repair the Proton Pass session.'
    STATUS_PROTON='needs a kernel-keyring session'
    return 1
  fi

  printf 'Login method: [i]nteractive, [p]ersonal access token, [s]kip: ' >/dev/tty
  IFS= read -r method </dev/tty || true
  case "$method" in
    ''|i|I)
      if ! pass-cli login --interactive; then
        warn 'Proton Pass interactive login did not complete.'
        STATUS_PROTON='login failed'
        return 1
      fi
      ;;
    p|P)
      printf 'Restricted, expiring Proton Pass token: ' >/dev/tty
      IFS= read -rs pat </dev/tty || true
      printf '\n' >/dev/tty
      if [ -z "$pat" ]; then
        warn 'No token was entered.'
        STATUS_PROTON='login skipped'
        return 1
      fi
      if ! PROTON_PASS_PERSONAL_ACCESS_TOKEN=$pat pass-cli login; then
        unset pat
        warn 'Proton Pass token login failed.'
        STATUS_PROTON='login failed'
        return 1
      fi
      unset pat
      ;;
    s|S)
      STATUS_PROTON='skipped for now'
      return 1
      ;;
    *)
      warn 'Unknown login method; Proton Pass was skipped.'
      STATUS_PROTON='skipped for now'
      return 1
      ;;
  esac

  if pass_logged_in; then
    STATUS_PROTON=ready
    log 'Proton Pass login completed.'
    return 0
  fi
  STATUS_PROTON='login could not be verified'
  warn 'Login returned, but Proton Pass is not ready.'
  return 1
}

valid_reference_value() {
  local value=$1
  case "$value" in
    *REPLACE_*|'') return 1 ;;
    pass://*/*/*) return 0 ;;
    *) return 1 ;;
  esac
}

reference_value_from_file() {
  local file=$1
  local name=$2
  local line
  [ -f "$file" ] || return 1
  [ ! -L "$file" ] || return 1
  line=$(grep -E "^${name}=" "$file" | tail -n 1 || true)
  [ -n "$line" ] || return 1
  printf '%s' "${line#*=}"
}

validate_reference_file() {
  local file=$1
  local line name value seen='' count=0
  [ -f "$file" ] || return 1
  [ ! -L "$file" ] || return 1

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
      *=*) ;;
      *) return 1 ;;
    esac
    name=${line%%=*}
    value=${line#*=}
    case "$name" in
      DEEPSEEK_API_KEY|GEMINI_API_KEY|MOONSHOT_API_KEY) ;;
      *) return 1 ;;
    esac
    case " $seen " in *" $name "*) return 1 ;; esac
    valid_reference_value "$value" || return 1
    seen="$seen $name"
    count=$((count + 1))
  done <"$file"
  [ "$count" -gt 0 ]
}

reference_resolves() {
  local name=$1
  local value=$2
  local probe status=0
  valid_reference_value "$value" || return 1
  probe=$(mktemp "${TMPDIR:-/tmp}/nix-config-reference.XXXXXX") || return 1
  chmod 600 "$probe" || { rm -f "$probe"; return 1; }
  printf '%s=%s\n' "$name" "$value" >"$probe" \
    || { rm -f "$probe"; return 1; }
  pass-cli run --env-file "$probe" -- node -e '
    const name = process.argv[1];
    if (!process.env[name]) process.exit(1);
  ' "$name" >/dev/null 2>&1 || status=$?
  rm -f "$probe"
  return "$status"
}

find_development_vault() {
  local vaults_json
  vaults_json=$(pass-cli vault list --output json) || return 1
  DEVELOPMENT_SHARE_ID=$(jq -r '
    [.vaults[]? | select(.name == "Development") | .share_id][0] // empty
  ' <<<"$vaults_json") || return 1
  [ -n "$DEVELOPMENT_SHARE_ID" ]
}

find_prepared_reference() {
  local name=$1
  local title=$2
  local alias=${3:-}
  local items_json item_id candidate candidate_title
  local titles=("$title")
  [ -z "$alias" ] || titles+=("$alias")
  find_development_vault || return 1
  items_json=$(pass-cli item list --share-id "$DEVELOPMENT_SHARE_ID" \
    --filter-state active --sort-by alphabetic-asc --output json) || return 1
  for candidate_title in "${titles[@]}"; do
    item_id=$(jq -r --arg title "$candidate_title" '
      [.items[]? | select(.title == $title) | .id][0] // empty
    ' <<<"$items_json") || return 1
    [ -n "$item_id" ] || continue
    candidate="pass://${DEVELOPMENT_SHARE_ID}/${item_id}/API%20Key"
    reference_resolves "$name" "$candidate" || continue
    DISCOVERED_REFERENCE=$candidate
    DISCOVERED_TITLE=$candidate_title
    return 0
  done
  return 1
}

show_secret_recipe() {
  local label=$1
  local title=$2
  printf '\n  Prepare this secret in Proton Pass:\n'
  printf '    Vault:       Development\n'
  printf '    Item title:  %s\n' "$title"
  printf '    Hidden field: API Key\n'
  printf '    Value:       your %s API key\n' "$label"
  printf '  Proton Pass web app: https://pass.proton.me\n'
  printf '  Keep this wizard open while adding it on this or another device.\n'
}

write_reference_file() {
  local output index count=0
  [ ! -L "$pass_env" ] || { warn "$pass_env is a symlink; refusing to replace it."; return 1; }
  mkdir -p "$config_dir" || return 1
  chmod 700 "$config_dir" || return 1
  umask 077

  for index in 0 1 2; do
    [ -z "${CONFIGURED_REFERENCES[index]}" ] || count=$((count + 1))
  done
  if [ "$count" -eq 0 ]; then
    rm -f "$pass_env"
  else
    output=$(mktemp "$config_dir/.pi.env.XXXXXX") || return 1
    chmod 600 "$output" || { rm -f "$output"; return 1; }
    printf '%s\n' '# Proton Pass references only. Never put secret values in this file.' >"$output" \
      || { rm -f "$output"; return 1; }
    for index in 0 1 2; do
      [ -z "${CONFIGURED_REFERENCES[index]}" ] && continue
      printf '%s=%s\n' "${PROVIDER_ENV_NAMES[$index]}" "${CONFIGURED_REFERENCES[index]}" >>"$output" \
        || { rm -f "$output"; return 1; }
    done
    mv -f "$output" "$pass_env" || { rm -f "$output"; return 1; }
    chmod 600 "$pass_env" || return 1
  fi
}

pi_api_key_conflicts() {
  [ -f "$pi_auth" ] || return 1
  node -e '
    const fs = require("node:fs");
    const managed = ["deepseek", "google", "moonshotai"];
    try {
      const auth = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      const conflicts = managed.filter((name) => auth[name]?.type === "api_key");
      if (conflicts.length) {
        console.log(conflicts.join(", "));
        process.exit(0);
      }
    } catch {}
    process.exit(1);
  ' "$pi_auth"
}

handle_shadowing_api_keys() {
  local conflicts
  conflicts=$(pi_api_key_conflicts) || return 0
  warn "Pi still has local API-key entries that override Proton Pass: $conflicts"
  log 'Pi owns auth.json, so the setup wizard will not edit it.'
  ask_optional 'Open Pi now? Use /logout for those API-key providers, then /exit.' yes
  if [ "$CHOICE" = yes ]; then
    PI_SKIP_PROTON_PASS=1 pi || true
  fi
  if conflicts=$(pi_api_key_conflicts); then
    warn "Still shadowed: $conflicts"
    STATUS_PI_KEYS="configured, but shadowed by $conflicts"
    return 1
  fi
}

configure_api_keys() {
  local index name label title alias existing
  section 'Optional Pi API keys'
  log 'The wizard looks only for Development / llm-<provider> / API Key.'
  log 'It reads item metadata and verifies fields without displaying secret values.'

  for index in 0 1 2; do
    name=${PROVIDER_ENV_NAMES[$index]}
    label=${PROVIDER_LABELS[$index]}
    title=${PROVIDER_ITEM_TITLES[$index]}
    alias=${PROVIDER_ITEM_ALIASES[$index]}
    existing=$(reference_value_from_file "$pass_env" "$name" || true)
    if valid_reference_value "$existing" && reference_resolves "$name" "$existing"; then
      CONFIGURED_REFERENCES[index]=$existing
      PROVIDER_STATUS[index]='ready (existing reference)'
      log "$label: existing reference is ready."
      continue
    fi

    if find_prepared_reference "$name" "$title" "$alias"; then
      CONFIGURED_REFERENCES[index]=$DISCOVERED_REFERENCE
      PROVIDER_STATUS[index]="ready ($DISCOVERED_TITLE)"
      log "$label: found and verified $DISCOVERED_TITLE."
      continue
    fi

    warn "$label was not found with the expected Proton Pass layout."
    ask_optional "Set up the optional $label API key now?" yes
    case "$CHOICE" in
      no) PROVIDER_STATUS[index]='not used' ;;
      skip) PROVIDER_STATUS[index]='skipped for now' ;;
      yes)
        while true; do
          show_secret_recipe "$label" "$title"
          ask_retry 'After saving the item, retry discovery?'
          if [ "$CHOICE" = skip ]; then
            PROVIDER_STATUS[index]='skipped for now'
            break
          fi
          if find_prepared_reference "$name" "$title" "$alias"; then
            CONFIGURED_REFERENCES[index]=$DISCOVERED_REFERENCE
            PROVIDER_STATUS[index]="ready ($DISCOVERED_TITLE)"
            log "$label: found and verified $DISCOVERED_TITLE."
            break
          fi
          warn "$title with a non-empty API Key field is still not available."
        done
        ;;
    esac
  done

  if write_reference_file; then
    if validate_reference_file "$pass_env"; then
      STATUS_PI_KEYS='ready'
      handle_shadowing_api_keys || true
    else
      STATUS_PI_KEYS='no API-key providers selected'
    fi
  else
    STATUS_PI_KEYS='could not save references'
  fi
}

pi_has_account_login() {
  [ -f "$pi_auth" ] || return 1
  node -e '
    const fs = require("node:fs");
    try {
      const auth = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      process.exit(Object.values(auth).some((entry) => entry && entry.type !== "api_key") ? 0 : 1);
    } catch { process.exit(1); }
  ' "$pi_auth"
}

configure_pi_login() {
  section 'Pi account login'
  if ! command -v pi >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1; then
    STATUS_PI_LOGIN='unavailable; Pi or Node.js is not installed'
    warn "$STATUS_PI_LOGIN"
    return
  fi
  if pi_has_account_login; then
    STATUS_PI_LOGIN=ready
    log 'Pi OAuth/account state is already present.'
    return
  fi
  ask_optional 'Open Pi to add an optional account/OAuth provider with /login?' yes
  case "$CHOICE" in
    yes)
      log 'Pi will open. Run /login, finish the provider flow, then run /exit.'
      PI_SKIP_PROTON_PASS=1 pi || true
      if pi_has_account_login; then STATUS_PI_LOGIN=ready; else STATUS_PI_LOGIN='not completed'; fi
      ;;
    no) STATUS_PI_LOGIN='not used' ;;
    skip) STATUS_PI_LOGIN='skipped for now' ;;
  esac
}

prompt_git_value() {
  local label=$1
  local key=$2
  local value
  printf '%s (or s to skip): ' "$label" >/dev/tty
  IFS= read -r value </dev/tty || true
  case "$value" in s|S) return 1 ;; esac
  [ -n "$value" ] || { warn "$label cannot be empty."; return 1; }
  if [ -L "$git_identity_file" ]; then
    warn "$git_identity_file is a symlink; refusing to replace it."
    return 1
  fi
  mkdir -p "${git_identity_file%/*}" || return 1
  git config --file "$git_identity_file" "$key" "$value" || return 1
  chmod 600 "$git_identity_file"
}

configure_git_identity() {
  local name email
  section 'Git identity'
  if ! command -v git >/dev/null 2>&1; then
    STATUS_GIT_IDENTITY='unavailable; Git is not installed'
    warn "$STATUS_GIT_IDENTITY"
    return
  fi
  name=$(git config --global --includes --get user.name 2>/dev/null || true)
  email=$(git config --global --includes --get user.email 2>/dev/null || true)
  if [ -n "$name" ] && [ -n "$email" ]; then
    STATUS_GIT_IDENTITY="ready ($name <$email>)"
    log "Git author is $name <$email>."
    return
  fi

  log 'Git author name and email are not secrets; commits need both.'
  if [ -z "$name" ]; then
    ask_optional 'Set the Git author name now?' yes
    [ "$CHOICE" != yes ] || prompt_git_value 'Git author name' user.name || true
  fi
  if [ -z "$email" ]; then
    ask_optional 'Set the Git author email now?' yes
    [ "$CHOICE" != yes ] || prompt_git_value 'Git author email' user.email || true
  fi
  name=$(git config --global --includes --get user.name 2>/dev/null || true)
  email=$(git config --global --includes --get user.email 2>/dev/null || true)
  if [ -n "$name" ] && [ -n "$email" ]; then
    STATUS_GIT_IDENTITY="ready ($name <$email>)"
  else
    STATUS_GIT_IDENTITY='incomplete'
  fi
}

configure_github() {
  section 'GitHub CLI'
  if ! command -v gh >/dev/null 2>&1; then
    STATUS_GITHUB='unavailable; GitHub CLI is not installed'
    warn "$STATUS_GITHUB"
    return
  fi
  if gh auth status >/dev/null 2>&1; then
    STATUS_GITHUB=ready
    log 'GitHub CLI is already authenticated.'
    return
  fi
  ask_optional 'Authenticate GitHub CLI now?' yes
  case "$CHOICE" in
    yes)
      if gh auth login && gh auth status >/dev/null 2>&1; then
        STATUS_GITHUB=ready
      else
        STATUS_GITHUB='login not completed'
        warn 'GitHub authentication is still incomplete.'
      fi
      ;;
    no) STATUS_GITHUB='not used' ;;
    skip) STATUS_GITHUB='skipped for now' ;;
  esac
}

configure_cloudflared() {
  section 'Cloudflare Tunnel'
  if ! command -v cloudflared >/dev/null 2>&1; then
    STATUS_CLOUDFLARED='unavailable; cloudflared is not installed'
    warn "$STATUS_CLOUDFLARED"
    return
  fi
  if [ -f "$HOME/.cloudflared/cert.pem" ]; then
    STATUS_CLOUDFLARED=ready
    log 'Cloudflare Tunnel certificate is present.'
    return
  fi
  ask_optional 'Authenticate cloudflared for tunnel management now?' no
  case "$CHOICE" in
    yes)
      if cloudflared tunnel login && [ -f "$HOME/.cloudflared/cert.pem" ]; then
        STATUS_CLOUDFLARED=ready
      else
        STATUS_CLOUDFLARED='login not completed'
        warn 'Cloudflare Tunnel authentication is still incomplete.'
      fi
      ;;
    no) STATUS_CLOUDFLARED='not used' ;;
    skip) STATUS_CLOUDFLARED='skipped for now' ;;
  esac
}

wrangler_logged_in() {
  command -v wrangler >/dev/null 2>&1 && wrangler whoami >/dev/null 2>&1
}

configure_wrangler() {
  section 'Cloudflare Wrangler'
  if ! command -v wrangler >/dev/null 2>&1; then
    STATUS_WRANGLER='unavailable; Wrangler is not installed'
    warn "$STATUS_WRANGLER"
    return
  fi
  if wrangler_logged_in; then
    STATUS_WRANGLER=ready
    log 'Wrangler is already authenticated.'
    return
  fi
  ask_optional 'Authenticate Wrangler for Cloudflare Workers now?' no
  case "$CHOICE" in
    yes)
      if wrangler login && wrangler_logged_in; then
        STATUS_WRANGLER=ready
      else
        STATUS_WRANGLER='login not completed'
        warn 'Wrangler authentication is still incomplete.'
      fi
      ;;
    no) STATUS_WRANGLER='not used' ;;
    skip) STATUS_WRANGLER='skipped for now' ;;
  esac
}

print_summary() {
  local index
  section 'Setup summary'
  printf '  %-22s %s\n' 'Proton Pass' "$STATUS_PROTON"
  for index in 0 1 2; do
    printf '  %-22s %s\n' "${PROVIDER_LABELS[$index]} API key" "${PROVIDER_STATUS[index]}"
  done
  printf '  %-22s %s\n' 'Pi API injection' "$STATUS_PI_KEYS"
  printf '  %-22s %s\n' 'Pi account login' "$STATUS_PI_LOGIN"
  printf '  %-22s %s\n' 'Git identity' "$STATUS_GIT_IDENTITY"
  printf '  %-22s %s\n' 'GitHub CLI' "$STATUS_GITHUB"
  printf '  %-22s %s\n' 'Cloudflare Tunnel' "$STATUS_CLOUDFLARED"
  printf '  %-22s %s\n' 'Wrangler' "$STATUS_WRANGLER"
  printf '\n  Rerun bro auth whenever you want to finish a skipped item.\n'
}

check_status() {
  local failed=0 index name value
  section 'Current setup status'
  if pass_logged_in; then
    STATUS_PROTON=ready
  else
    STATUS_PROTON='not logged in'
  fi
  printf '  %-22s %s\n' 'Proton Pass' "$STATUS_PROTON"

  if [ -e "$pass_env" ] && ! validate_reference_file "$pass_env"; then
    printf '  %-22s %s\n' 'Pi API references' 'invalid'
    failed=1
  else
    for index in 0 1 2; do
      name=${PROVIDER_ENV_NAMES[$index]}
      value=$(reference_value_from_file "$pass_env" "$name" || true)
      if [ -z "$value" ]; then
        PROVIDER_STATUS[index]='not configured (optional)'
      elif pass_logged_in && ! command -v node >/dev/null 2>&1; then
        PROVIDER_STATUS[index]='not checked; Node.js is unavailable'
        failed=1
      elif pass_logged_in && reference_resolves "$name" "$value"; then
        PROVIDER_STATUS[index]=ready
      elif pass_logged_in; then
        PROVIDER_STATUS[index]='does not resolve'
        failed=1
      else
        PROVIDER_STATUS[index]='configured; Proton Pass unavailable'
        failed=1
      fi
      printf '  %-22s %s\n' "${PROVIDER_LABELS[$index]} API key" "${PROVIDER_STATUS[index]}"
    done
  fi

  if conflicts=$(pi_api_key_conflicts); then
    printf '  %-22s %s\n' 'Pi API shadowing' "$conflicts"
    failed=1
  fi
  if ! command -v node >/dev/null 2>&1; then
    printf '  %-22s %s\n' 'Pi account login' 'not checked; Node.js is unavailable'
  elif pi_has_account_login; then
    printf '  %-22s %s\n' 'Pi account login' ready
  else
    printf '  %-22s %s\n' 'Pi account login' 'not configured (optional)'
  fi
  if command -v git >/dev/null 2>&1; then
    name=$(git config --global --includes --get user.name 2>/dev/null || true)
    value=$(git config --global --includes --get user.email 2>/dev/null || true)
    if [ -n "$name" ] && [ -n "$value" ]; then printf '  %-22s %s\n' 'Git identity' "$name <$value>"; else printf '  %-22s %s\n' 'Git identity' incomplete; fi
  else
    printf '  %-22s %s\n' 'Git identity' 'unavailable; Git is not installed'
  fi
  if ! command -v gh >/dev/null 2>&1; then printf '  %-22s %s\n' 'GitHub CLI' 'unavailable; GitHub CLI is not installed'; elif gh auth status >/dev/null 2>&1; then printf '  %-22s %s\n' 'GitHub CLI' ready; else printf '  %-22s %s\n' 'GitHub CLI' 'not authenticated (optional)'; fi
  if [ -f "$HOME/.cloudflared/cert.pem" ]; then printf '  %-22s %s\n' 'Cloudflare Tunnel' ready; else printf '  %-22s %s\n' 'Cloudflare Tunnel' 'not authenticated (optional)'; fi
  if wrangler_logged_in; then printf '  %-22s %s\n' 'Wrangler' ready; else printf '  %-22s %s\n' 'Wrangler' 'not authenticated (optional)'; fi
  return "$failed"
}

main() {
  case "${1:-}" in
    -h|--help) usage; return 0 ;;
    --check) check_status; return ;;
    '') ;;
    *) usage >&2; return 2 ;;
  esac

  has_tty || fail 'interactive setup requires a terminal'

  printf '\nNix Config Account Setup\n'
  printf '========================\n'
  printf 'This wizard detects what is ready and asks only about missing optional items.\n'
  printf 'It never opens an editor and never writes secret values to disk.\n'

  section 'Proton Pass'
  if ! command -v pass-cli >/dev/null 2>&1 \
    || ! command -v jq >/dev/null 2>&1 \
    || ! command -v node >/dev/null 2>&1; then
    STATUS_PROTON='unavailable; pass-cli, jq, or Node.js is missing'
    warn "$STATUS_PROTON"
  elif pass_logged_in; then
    STATUS_PROTON=ready
    log 'Proton Pass session is ready.'
  else
    ask_optional 'Connect Proton Pass to discover optional Pi API keys?' yes
    if [ "$CHOICE" = yes ]; then
      login_proton_pass || true
    elif [ "$CHOICE" = no ]; then
      STATUS_PROTON='not used'
    else
      STATUS_PROTON='skipped for now'
    fi
  fi

  if command -v jq >/dev/null 2>&1 && command -v node >/dev/null 2>&1 \
    && pass_logged_in; then
    configure_api_keys
  else
    STATUS_PI_KEYS='not checked; Proton Pass unavailable'
    PROVIDER_STATUS=('not checked' 'not checked' 'not checked')
  fi

  configure_pi_login
  configure_git_identity
  configure_github
  configure_cloudflared
  configure_wrangler
  print_summary
}

main "$@"
