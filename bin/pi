#!/usr/bin/env bash
set -euo pipefail

# Pi's scoped-model selector can remove enabledModels when it decides that all
# catalog models are enabled. Restore the versioned list before every launch.
if command -v pi-models-sync >/dev/null 2>&1; then
  pi-models-sync || printf 'warning: could not restore Pi scoped models\n' >&2
fi

# This wrapper lives in ~/.local/bin, which is intentionally first in PATH.
# Find the real Pi executable in the remaining PATH entries.
self="$HOME/.local/bin/pi"
real_pi=''
old_ifs=$IFS
IFS=:
for dir in $PATH; do
  [ -n "$dir" ] || dir='.'
  candidate="$dir/pi"
  [ "$candidate" = "$self" ] && continue
  if [ -x "$candidate" ]; then
    real_pi="$candidate"
    break
  fi
done
IFS=$old_ifs

if [ -z "$real_pi" ]; then
  printf 'error: the pi executable was not found outside %s\n' "$self" >&2
  exit 127
fi

# API keys remain in Proton Pass. A local dotenv file contains only opaque
# pass:// references. Resolve them before directly exec'ing Pi: pass-cli pipes
# a child command's descriptors, which would make Pi think it has no terminal.
# Pi continues to own ~/.pi/agent/auth.json and its mutable OAuth sessions.
pass_env=${PROTON_PASS_PI_ENV_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/proton-pass/pi.env}
case "${PI_SKIP_PROTON_PASS:-}" in
  1|true|TRUE|yes|YES) exec "$real_pi" "$@" ;;
esac

if [ -f "$pass_env" ]; then
  if [ "$(uname -s)" = Linux ] && command -v keyctl >/dev/null 2>&1 \
    && ! keyctl show >/dev/null 2>&1; then
    if command -v proton-pass-session >/dev/null 2>&1; then
      exec proton-pass-session "$self" "$@"
    fi
    printf 'error: the Linux kernel keyring is unavailable\n' >&2
    printf 'hint: run bro auth to repair the Proton Pass session\n' >&2
    exit 1
  fi
  if ! command -v pass-cli >/dev/null 2>&1; then
    printf 'error: %s exists but pass-cli is unavailable\n' "$pass_env" >&2
    printf 'hint: run bro auth to repair account setup\n' >&2
    exit 127
  fi
  if ! command -v proton-pass-pi-env >/dev/null 2>&1; then
    printf 'error: proton-pass-pi-env is unavailable\n' >&2
    printf 'hint: run bro auth to repair account setup\n' >&2
    exit 127
  fi
  if pass_exports=$(proton-pass-pi-env "$pass_env"); then
    :
  else
    exit $?
  fi
  eval "$pass_exports"
  exec "$real_pi" "$@"
fi

exec "$real_pi" "$@"
