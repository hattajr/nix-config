#!/usr/bin/env bash
set -euo pipefail

# Resolve the Pass references into export statements for the Pi launcher.
# pass-cli owns this short-lived, non-interactive command; Pi is subsequently
# exec'd directly so its stdin, stdout, and stderr remain attached to the TTY.
pass_env=${1:?usage: proton-pass-pi-env ENV_FILE}

if ! command -v pass-cli >/dev/null 2>&1; then
  printf 'error: pass-cli is unavailable\n' >&2
  exit 127
fi

names=()
while IFS= read -r line || [ -n "$line" ]; do
  line=${line#"${line%%[![:space:]]*}"}
  [[ $line =~ ^([a-zA-Z_][a-zA-Z0-9_]*)= ]] || continue
  names+=("${BASH_REMATCH[1]}")
done <"$pass_env"

# pass-cli masks resolved values by default, which would make these export
# statements invalid; --no-masking is safe here because stdout is captured by
# the launcher rather than displayed. %q makes that captured output safe for
# eval while retaining arbitrary key values. This Bash process is the only
# pass-cli child whose descriptors may be piped; Pi itself never is.
exec pass-cli run --no-masking --env-file "$pass_env" -- bash -c '
  for name; do
    if [[ ! -v $name ]]; then
      printf "error: Proton Pass did not resolve %s\\n" "$name" >&2
      exit 1
    fi
    printf "export %s=%q\\n" "$name" "${!name}"
  done
' proton-pass-pi-env "${names[@]}"
