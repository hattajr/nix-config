# Reference-format documentation only; nix-config-setup creates pi.env.
# API-key providers are optional. Values are references, never credentials.
# API%20Key is the URL-encoded Proton Pass field name "API Key".
DEEPSEEK_API_KEY=pass://REPLACE_SHARE_ID/REPLACE_DEEPSEEK_ITEM_ID/API%20Key
GEMINI_API_KEY=pass://REPLACE_SHARE_ID/REPLACE_GEMINI_ITEM_ID/API%20Key
MOONSHOT_API_KEY=pass://REPLACE_SHARE_ID/REPLACE_MOONSHOT_ITEM_ID/API%20Key
