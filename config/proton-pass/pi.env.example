# Copy to ~/.config/proton-pass/pi.env and replace every placeholder with
# opaque IDs from `pass-cli vault list --output json` and
# `pass-cli item list --vault-name Development --output json`.
# Values are references, not credentials. The field segment is mandatory.
DEEPSEEK_API_KEY=pass://REPLACE_SHARE_ID/REPLACE_DEEPSEEK_ITEM_ID/API_KEY
GEMINI_API_KEY=pass://REPLACE_SHARE_ID/REPLACE_GOOGLE_ITEM_ID/API_KEY
MOONSHOT_API_KEY=pass://REPLACE_SHARE_ID/REPLACE_MOONSHOT_ITEM_ID/API_KEY
