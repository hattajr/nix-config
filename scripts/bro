#!/usr/bin/env bash
# The single interactive front door. Every operation is reachable from the menu
# and nothing is configured by typing a flag or an environment variable.
set -euo pipefail

LIB_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/lib" && pwd -P)
# shellcheck source=lib/core.sh
. "$LIB_DIR/core.sh"
# shellcheck source=lib/nix.sh
. "$LIB_DIR/nix.sh"
# shellcheck source=lib/actions.sh
. "$LIB_DIR/actions.sh"

run_step() {
  # A failed step returns to the menu: an unusable network or a dirty tree is
  # something to correct and retry, not a reason to drop the session. The
  # subshell matters, because actions report problems with fail, which exits.
  ( "$@" ) || warn 'returning to the menu'
}

main() {
  [ "$#" -eq 0 ] || {
    printf 'bro takes no arguments; run bro on its own to open the menu.\n' >&2
    exit 2
  }
  has_tty || fail 'bro is interactive; run it from a terminal'

  enable_nix_features
  resolve_identity
  local repo target
  repo=$(resolve_checkout)
  target=$(detect_platform)

  while true; do
    choose "nix-config  ($target)" \
      $'Apply\tactivate this checkout' \
      $'Sync\tfast-forward from upstream, then apply' \
      $'Update\tchange pinned Nixpkgs or Pi versions' \
      $'Accounts\tconfigure logins and API keys' \
      $'Health\tcheck shell, accounts, and PATH' \
      $'Clean up\tquarantine binaries shadowing Nix' \
      $'Quit\tleave the menu' || return 0
    case "$CHOICE_INDEX" in
      1) run_step apply "$repo" "$target" ;;
      2) run_step sync "$repo" "$target" ;;
      3) run_step update "$repo" "$target" ;;
      4) run_step auth ;;
      5)
        run_step health "$repo" "$target"
        if shadowed_binaries_present \
          && confirm 'Review the shadowed binaries now?' no; then
          run_step shadow_review
        fi
        ;;
      6) run_step shadow_review ;;
      7) return 0 ;;
    esac
  done
}

main "$@"
