#!/usr/bin/env bash
# The single interactive front door. Every operation is reachable from the menu
# and nothing is configured by typing a flag or an environment variable.
set -euo pipefail

LIB_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/lib" && pwd -P)
# shellcheck source=lib/core.sh
. "$LIB_DIR/core.sh"
# shellcheck source=lib/nix.sh
. "$LIB_DIR/nix.sh"
# shellcheck source=lib/actions.sh
. "$LIB_DIR/actions.sh"

run_step() {
  # A failed step returns to the menu: an unusable network or a dirty tree is
  # something to correct and retry, not a reason to drop the session. The
  # subshell matters, because actions report problems with fail, which exits.
  ( "$@" ) || warn 'returning to the menu'
}

# An action is a step whose commands are logged: it gets a fresh log, and in
# styled mode ends on a line saying how it went and where that log is. The log
# is best effort: without one the action still runs, unboxed as in plain mode.
run_action() {
  local name=$1 started=$SECONDS && shift
  open_action_log "$name" || warn "$name runs without a log"
  if ( "$@" ); then
    report_action ok "$name" "$((SECONDS - started))"
  else
    report_action fail "$name" "$((SECONDS - started))"
    warn 'returning to the menu'
  fi
  ACTION_LOG=''
}

main() {
  [ "$#" -eq 0 ] || {
    printf 'bro takes no arguments; run bro on its own to open the menu.\n' >&2
    exit 2
  }
  has_tty || fail 'bro is interactive; run it from a terminal'

  enable_nix_features
  resolve_identity
  local repo target
  repo=$(resolve_checkout)
  target=$(detect_platform)

  local items=(
    $'Apply\tactivate this checkout'
    $'Sync\tfast-forward from upstream, then apply'
    $'Update\tchange pinned versions or update Pi extensions'
    $'Accounts\tconfigure logins and API keys'
    $'Health\tcheck shell, accounts, and PATH'
    $'Clean up\tquarantine binaries shadowing Nix'
  )
  # Background jobs are systemd user timers, which only Linux has.
  case "$target" in
    *-linux) items+=($'Jobs\tchoose background jobs for this machine') ;;
  esac
  items+=($'Quit\tleave the menu')

  while true; do
    choose "nix-config  ($target)" "${items[@]}" || return 0
    # Dispatch on the label, because which items appear depends on the platform.
    case "${items[CHOICE_INDEX - 1]%%$'\t'*}" in
      Apply) run_action Apply apply "$repo" "$target" ;;
      Sync) run_action Sync sync "$repo" "$target" ;;
      Update) run_step update "$repo" "$target" ;;
      Accounts) run_step auth ;;
      Health)
        run_step health "$repo" "$target"
        if shadowed_binaries_present \
          && confirm 'Review the shadowed binaries now?' no; then
          run_step shadow_review
        fi
        ;;
      'Clean up') run_step shadow_review ;;
      Jobs) run_step background_jobs "$repo" "$target" ;;
      Quit) return 0 ;;
    esac
  done
}

main "$@"
